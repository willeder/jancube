{
  "name": "jancube",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @jancube/web dev",
    "dev:jobs": "pnpm --filter @jancube/jobs dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check": "pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "tsx db/migrate.ts --reset && tsx db/seed.ts",
    "db:codegen": "kysely-codegen --dialect mysql --url mysql://root:jancube@127.0.0.1:3306/jancube --out-file packages/infrastructure/src/db/schema.generated.ts",
    "db:tidb:up": "docker compose up -d tidb",
    "db:tidb:check": "tsx db/migrate.ts --target tidb --reset && tsx db/verify-compat.ts tidb",
    "db:verify": "tsx db/verify-compat.ts mysql"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.5.0",
    "dotenv": "^17.0.0",
    "kysely-codegen": "^0.20.0",
    "mysql2": "^3.24.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
