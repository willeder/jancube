{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jancube-jobs-beta",
  "account_id": "2237a997c55be463e38cb352e6a6b0ee",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Enable the agreed minute/20:00-JST schedules only after database/provider acceptance.
  "triggers": { "crons": [] },
  "vars": {
    "APP_ENV": "staging",
    "APP_URL": "https://jancube-web-beta.rokad.workers.dev",
    "EMAIL_FROM": "Jancube beta <no-reply@jancube.invalid>",
    "BETA_SETUP_MODE": "1"
  }
}
