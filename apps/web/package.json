{
  "name": "@jancube/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "wrangler types --env-interface CloudflareEnv && next build",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "wrangler types --env-interface CloudflareEnv && tsc -p tsconfig.json",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "@jancube/application": "workspace:*",
    "@jancube/domain": "workspace:*",
    "@jancube/infrastructure": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.10",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "wrangler": "^4.149.0"
  }
}
