# Copy to .dev.vars for local overrides. In deployed environments set these with `wrangler secret put`.
# With APP_ENV=development, built-in development values are used when these are unset.
AUTH_PEPPER=change-me-at-least-16-characters
SESSION_SECRET=change-me-at-least-32-characters-long
SMSLINK_API_TOKEN=
SMSLINK_ENDPOINT=
# Stripe test keys (sk_test_…). Without them, development uses a local stand-in checkout page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
# 32 random bytes, base64 (encrypts entry codes and notification destinations). Same value for jobs.
DATA_ENCRYPTION_KEY=
RESEND_API_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
# C-21 maintenance screen for customer pages (1 = on). Optional text, e.g. the planned period.
MAINTENANCE_MODE=
MAINTENANCE_MESSAGE=
# SmartRooming Connect API token (entrance lock codes). Without it, development generates codes
# locally. Same values for the jobs worker. SMARTROOMING_TIME_ZONE: time zone of passcode periods.
SMARTROOMING_API_TOKEN=
SMARTROOMING_BASE_URL=
SMARTROOMING_TIME_ZONE=
