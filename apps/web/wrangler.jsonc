{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jancube-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      // Production: TiDB Cloud Starter (Tokyo) via Hyperdrive. Replace the id after `wrangler hyperdrive create`.
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      // Local development: Docker MySQL from the repo root (`pnpm db:up`).
      "localConnectionString": "mysql://root:jancube@127.0.0.1:3306/jancube"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "EMAIL_FROM": "雀CUBE <no-reply@jancube.net>"
  }
}
